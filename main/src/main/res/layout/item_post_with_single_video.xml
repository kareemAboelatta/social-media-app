<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_medium"
    style="@style/simple_card"
    app:cardElevation="@dimen/elevation_low"
    app:cardUseCompatPadding="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/post_header"
            layout="@layout/layout_post_header" />


        <com.borjabravo.readmoretextview.ReadMoreTextView
            android:id="@+id/post_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:autoLink="all"
            android:textSize="20sp"
            android:textStyle="normal"
            app:trimCollapsedText=" Show less"
            app:trimExpandedText=" Show More"
            app:trimLength="200"
            app:trimMode="trimModeLength"
            tools:text="I love my mom" />

        <RelativeLayout
            android:id="@+id/video_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_160sdp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/RoundedShapeAppearance"
                tools:src="@tools:sample/avatars" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@color/colorBlackTrans"
                app:shapeAppearance="@style/RoundedShapeAppearance" />

            <ImageView
                android:id="@+id/play_icon"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_circle_play" />

        </RelativeLayout>


        <include
            android:id="@+id/post_footer"
            layout="@layout/layout_post_footer" />


    </LinearLayout>


</com.google.android.material.card.MaterialCardView>